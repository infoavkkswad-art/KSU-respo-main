# Copy to backend/.env for local uvicorn (cwd = backend/).
# Render injects the same names. Never commit a filled .env.
#
# VITE_API_BASE_URL is a frontend BUILD-TIME Vite variable.
# Empty production builds fall back to https://api.kawadswad.in
# in src/services/api-client.ts.

# Required — API will not boot if empty or a source placeholder
# (rzp_test_placeholder, placeholder_secret, webhook_secret_placeholder,
#  or any value containing "placeholder").
MONGODB_URI=
MONGODB_DATABASE=kawad_swad_db
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional — comma-separated browser origins.
# If unset, backend/app/config.py includes production hosts plus localhost.
CORS_ORIGINS=

# Optional — Google Apps Script order/payment sync (not required to boot).
GOOGLE_APPS_SCRIPT_URL=
GOOGLE_APPS_SCRIPT_TOKEN=

# Optional — India Post booking is not wired into checkout yet.
INDIA_POST_BASE_URL=
INDIA_POST_CUSTOMER_ID=
INDIA_POST_USERNAME=
INDIA_POST_PASSWORD=

# Frontend only (set at vite build time, not read by FastAPI).
VITE_API_BASE_URL=
